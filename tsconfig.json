{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2020"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2020",
    "types": ["react", "react-dom"]
  },
  "include": ["src"],
  "exclude": ["src/template.tsx", "src/preview.html", "node_modules"]
}
